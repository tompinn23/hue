{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when scanning a navigation beacon, before the scan data for all the bodies in the system is written into the journal",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "SystemAddress": {
      "title": "SystemAddress",
      "type": "integer",
      "examples": [
        8216113749,
        9466778953105,
        190289282228
      ]
    },
    "NumBodies": {
      "title": "NumBodies",
      "type": "integer",
      "examples": [
        50,
        16,
        13
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "NumBodies",
    "SystemAddress",
    "event",
    "timestamp"
  ]
}
