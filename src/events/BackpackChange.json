{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This is written when there is any change to the contents of the suit backpack – note this can be written at the same time as other events like UseConsumable",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Added": {
      "title": "Added",
      "type": "array",
      "default": null,
      "items": {
        "$ref": "#/definitions/changeEntry"
      }
    },
    "Removed": {
      "title": "Removed",
      "type": "array",
      "default": null,
      "items": {
        "$ref": "#/definitions/changeEntry"
      }
    }
  },
  "definitions": {
    "changeEntry": {
      "type": "object",
      "properties": {
        "Name": {
          "title": "Name",
          "type": "string",
          "examples": [
            "energycell",
            "amm_grenade_emp",
            "amm_grenade_frag"
          ]
        },
        "Name_Localised": {
          "title": "Name_Localised",
          "type": "string",
          "examples": [
            "Energy Cell",
            "Shield Disruptor",
            "Frag Grenade"
          ]
        },
        "OwnerID": {
          "title": "OwnerID",
          "type": "integer",
          "examples": [
            0,
            2954264951,
            2952913247
          ]
        },
        "Count": {
          "title": "Count",
          "type": "integer",
          "examples": [
            1,
            8,
            4
          ]
        },
        "Type": {
          "title": "Type",
          "type": "string",
          "examples": [
            "Consumable",
            "Component",
            "Item"
          ]
        },
        "MissionID": {
          "title": "MissionID",
          "type": "integer",
          "examples": [
            839014036,
            895446120,
            895536604
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Name",
        "OwnerID",
        "Count",
        "Type"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "event",
    "timestamp"
  ]
}
