{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when selling a module in outfitting",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        128666762,
        129009496,
        3705689344
      ]
    },
    "Slot": {
      "title": "Slot",
      "type": "string",
      "examples": [
        "SmallHardpoint2",
        "SmallHardpoint1",
        "Slot01_Size6"
      ]
    },
    "SellItem": {
      "title": "SellItem",
      "type": "string",
      "examples": [
        "$hpt_pulselaser_fixed_small_name;",
        "$int_cargorack_size5_class1_name;",
        "$int_cargorack_size2_class1_name;"
      ]
    },
    "SellItem_Localised": {
      "title": "SellItem_Localised",
      "type": "string",
      "examples": [
        "Pulse Laser",
        "Cargo Rack",
        "Supercruise Assist"
      ]
    },
    "SellPrice": {
      "title": "SellPrice",
      "type": "integer",
      "examples": [
        1980,
        100409,
        2925
      ]
    },
    "Ship": {
      "title": "Ship",
      "type": "string",
      "examples": [
        "asp",
        "anaconda",
        "empire_courier"
      ]
    },
    "ShipID": {
      "title": "ShipID",
      "type": "integer",
      "examples": [
        34,
        38,
        39
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "MarketID",
    "SellItem",
    "SellPrice",
    "Ship",
    "ShipID",
    "Slot",
    "event",
    "timestamp"
  ]
}
