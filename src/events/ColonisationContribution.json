{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when contributing materials to a colonisation effort",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        128666762,
        129009496,
        3705689344
      ]
    },
    "Contributions": {
      "title": "Contributions",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "title": "Name",
            "type": "string",
            "examples": [
              "$Aluminium_name;"
            ]
          },
          "Name_Localised": {
            "title": "Name_Localised",
            "type": "string",
            "examples": [
              "Aluminium"
            ]
          },
          "Amount": {
            "title": "Amount",
            "type": "integer",
            "examples": [
              724
            ]
          }
        },
        "required": [
          "Name",
          "Name_Localised",
          "Amount"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "Contributions",
    "MarketID",
    "event",
    "timestamp"
  ]
}
