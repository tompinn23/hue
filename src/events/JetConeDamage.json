{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when passing through the jet code from a white dwarf or neutron star has caused damage to a ship module",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Module": {
      "title": "Module",
      "type": "string",
      "examples": [
        "$int_detailedsurfacescanner_tiny_name;",
        "$int_supercruiseassist_name;"
      ]
    },
    "Module_Localised": {
      "title": "Module_Localised",
      "type": "string",
      "examples": [
        "Surface Scanner",
        "Supercruise Assist"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Module",
    "event",
    "timestamp"
  ]
}
