{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when changing the task assignment of a member of crew",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Name": {
      "title": "Name",
      "type": "string",
      "examples": [
        "Alice",
        "Bob",
        "Mallory"
      ]
    },
    "CrewID": {
      "title": "CrewID",
      "type": "integer",
      "examples": [
        216828288,
        218204548,
        236064356
      ]
    },
    "Role": {
      "title": "Role",
      "type": "string",
      "examples": [
        "Active"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CrewID",
    "Name",
    "Role",
    "event",
    "timestamp"
  ]
}
