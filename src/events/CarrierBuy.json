{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "Player has bought a fleet carrier",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "CarrierID": {
      "title": "CarrierID",
      "type": "integer",
      "examples": [
        3707430144,
        3705124096
      ]
    },
    "CarrierType": {
      "title": "CarrierType",
      "type": "string",
      "examples": [
        "FleetCarrier",
        "SquadronCarrier"
      ]
    },
    "BoughtAtMarket": {
      "title": "BoughtAtMarket",
      "type": "integer",
      "examples": [
        128667761,
        3223259392
      ]
    },
    "Location": {
      "title": "Location",
      "type": "string",
      "examples": [
        "Eol Prou LW-L c8-197",
        "Mitnahas"
      ]
    },
    "SystemAddress": {
      "title": "SystemAddress",
      "type": "integer",
      "examples": [
        54218827539018,
        7267218695553
      ]
    },
    "Price": {
      "title": "Price",
      "type": "integer",
      "examples": [
        3500000000,
        5000000000
      ]
    },
    "Variant": {
      "title": "Variant",
      "type": "string",
      "examples": [
        "CarrierDockB"
      ]
    },
    "Callsign": {
      "title": "Callsign",
      "type": "string",
      "examples": [
        "A1A-B2B"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "BoughtAtMarket",
    "Callsign",
    "CarrierID",
    "Location",
    "Price",
    "SystemAddress",
    "Variant",
    "event",
    "timestamp"
  ]
}
