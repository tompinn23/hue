{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When dropping out of supercruise at a targeted destination",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "$USS_Type_MissionTarget;"
      ]
    },
    "Type_Localised": {
      "title": "Type_Localised",
      "type": "string",
      "examples": [
        "Target"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        3705689344,
        3701165824,
        3222025216
      ]
    },
    "Threat": {
      "title": "Threat",
      "type": "integer",
      "examples": [
        0
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Threat",
    "Type",
    "event",
    "timestamp"
  ]
}
