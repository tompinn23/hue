{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This event records that a player has sold organic data (see ScanOrganic)",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        3705689344,
        128927917,
        3226858240
      ]
    },
    "BioData": {
      "title": "BioData",
      "type": "array",
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "Genus": {
            "title": "Genus",
            "type": "string",
            "examples": [
              "$Codex_Ent_Fonticulus_Genus_Name;",
              "$Codex_Ent_Bacterial_Genus_Name;",
              "$Codex_Ent_Stratum_Genus_Name;"
            ]
          },
          "Genus_Localised": {
            "title": "Genus_Localised",
            "type": "string",
            "examples": [
              "Fonticulua",
              "Bacterium",
              "Stratum"
            ]
          },
          "Species": {
            "title": "Species",
            "type": "string",
            "examples": [
              "$Codex_Ent_Fonticulus_02_Name;",
              "$Codex_Ent_Bacterial_12_Name;",
              "$Codex_Ent_Stratum_02_Name;"
            ]
          },
          "Species_Localised": {
            "title": "Species_Localised",
            "type": "string",
            "examples": [
              "Fonticulua Campestris",
              "Bacterium Cerbrus",
              "Stratum Paleas"
            ]
          },
          "Variant": {
            "title": "Variant",
            "type": "string",
            "examples": [
              "$Codex_Ent_Tubus_01_A_Name;"
            ]
          },
          "Variant_Localised": {
            "title": "Variant_Localised",
            "type": "string",
            "examples": [
              "Tubus Conifer - Indigo"
            ]
          },
          "Value": {
            "title": "Value",
            "type": "integer",
            "examples": [
              63600,
              121300,
              102500
            ]
          },
          "Bonus": {
            "title": "Bonus",
            "type": "integer",
            "examples": [
              0,
              121300,
              102500
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "Genus",
          "Species",
          "Value",
          "Bonus"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "BioData",
    "MarketID",
    "event",
    "timestamp"
  ]
}
