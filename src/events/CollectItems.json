{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When picking up items from the ground",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Name": {
      "title": "Name",
      "type": "string",
      "examples": [
        "tungstencarbide",
        "energycell",
        "compressionliquefiedgas"
      ]
    },
    "Name_Localised": {
      "title": "Name_Localised",
      "description": "The localised value will be omitted if it is exactly the same as Name",
      "type": "string",
      "examples": [
        "Tungsten Carbide",
        "Energy Cell",
        "Compression-Liquefied Gas"
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "Component",
        "Consumable",
        "Item"
      ]
    },
    "OwnerID": {
      "title": "OwnerID",
      "type": "integer",
      "examples": [
        0,
        2953835433,
        2953835425
      ]
    },
    "Count": {
      "title": "Count",
      "type": "integer",
      "examples": [
        1,
        4,
        8
      ]
    },
    "Stolen": {
      "title": "Stolen",
      "type": "boolean",
      "examples": [
        true,
        false
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Count",
    "Name",
    "OwnerID",
    "Stolen",
    "Type",
    "event",
    "timestamp"
  ]
}
