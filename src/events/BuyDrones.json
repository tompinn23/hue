{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when purchasing drones",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "Drones"
      ]
    },
    "Count": {
      "title": "Count",
      "type": "integer",
      "examples": [
        105,
        20,
        1
      ]
    },
    "BuyPrice": {
      "title": "BuyPrice",
      "type": "integer",
      "examples": [
        122,
        101,
        82
      ]
    },
    "TotalCost": {
      "title": "TotalCost",
      "type": "integer",
      "examples": [
        12810,
        2020,
        82
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "BuyPrice",
    "Count",
    "TotalCost",
    "Type",
    "event",
    "timestamp"
  ]
}
