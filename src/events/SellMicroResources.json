{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This event is logged when a player sells Microresources for cash",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "TotalCount": {
      "title": "TotalCount",
      "type": "integer",
      "examples": [
        1,
        109,
        2
      ]
    },
    "MicroResources": {
      "title": "MicroResources",
      "type": "array",
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "title": "Name",
            "type": "string",
            "examples": [
              "largecapacitypowerregulator",
              "circuitswitch",
              "opticalfibre"
            ]
          },
          "Name_Localised": {
            "title": "Name_Localised",
            "type": "string",
            "examples": [
              "Power Regulator",
              "Circuit Switch",
              "Optical Fibre"
            ]
          },
          "Category": {
            "title": "Category",
            "type": "string",
            "examples": [
              "Item",
              "Component",
              "Data"
            ]
          },
          "Count": {
            "title": "Count",
            "type": "integer",
            "examples": [
              1,
              34,
              5
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "Name",
          "Category",
          "Count"
        ]
      }
    },
    "Price": {
      "title": "Price",
      "type": "integer",
      "examples": [
        500000,
        42200,
        200000
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        3705689344,
        3227537408,
        3227506432
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "MarketID",
    "MicroResources",
    "Price",
    "TotalCount",
    "event",
    "timestamp"
  ]
}
