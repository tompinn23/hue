{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "CarrierID": {
      "title": "CarrierID",
      "type": "integer",
      "examples": [
        3705689344
      ]
    },
    "CarrierType": {
      "title": "CarrierType",
      "type": "string",
      "examples": [
        "FleetCarrier",
        "SquadronCarrier"
      ]
    },
    "Operation": {
      "title": "Operation",
      "type": "string",
      "examples": [
        "SellPack",
        "BuyPack",
        "RestockPack"
      ]
    },
    "PackTheme": {
      "title": "PackTheme",
      "type": "string",
      "examples": [
        "Sensors",
        "Mining Utilities",
        "VehicleSupport"
      ]
    },
    "PackTier": {
      "title": "PackTier",
      "type": "integer",
      "examples": [
        3,
        1,
        2
      ]
    },
    "Refund": {
      "title": "Refund",
      "type": "integer",
      "examples": [
        345554641,
        554315009,
        19160455
      ]
    },
    "Cost": {
      "title": "Cost",
      "type": "integer",
      "examples": [
        9554600,
        566276585,
        19181515
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CarrierID",
    "Operation",
    "PackTheme",
    "PackTier",
    "event",
    "timestamp"
  ]
}
