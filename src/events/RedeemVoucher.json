{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when claiming payment for combat bounties and bonds",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "bounty",
        "codex",
        "CombatBond"
      ]
    },
    "Faction": {
      "title": "Faction",
      "type": "string",
      "examples": [
        "PilotsFederation",
        "Wandrama Purple Council",
        "Materia Auxiliatores"
      ]
    },
    "Amount": {
      "title": "Amount",
      "description": "Net amount received, after any broker fee",
      "type": "integer",
      "examples": [
        1400,
        5062,
        22100
      ]
    },
    "Factions": {
      "title": "Factions",
      "description": "For type bounty",
      "type": "array",
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "Faction": {
            "title": "Faction",
            "type": "string",
            "examples": [
              "United HIP 20485 Nationalists",
              "",
              "Aristocrats of Latorioson"
            ]
          },
          "Amount": {
            "title": "Amount",
            "type": "integer",
            "examples": [
              1400,
              5062,
              8800
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "Faction",
          "Amount"
        ]
      }
    },
    "BrokerPercentage": {
      "title": "BrokerPercentage",
      "type": "number",
      "examples": [
        25.0
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Amount",
    "Type",
    "event",
    "timestamp"
  ]
}
