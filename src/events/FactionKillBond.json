{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: Player rewarded for taking part in a combat zone",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Reward": {
      "title": "Reward",
      "type": "integer",
      "examples": [
        80000,
        8000000,
        54840
      ]
    },
    "AwardingFaction": {
      "title": "AwardingFaction",
      "type": "string",
      "examples": [
        "$faction_PilotsFederation;",
        "Wandrama Purple Council",
        "Materia Auxiliatores"
      ]
    },
    "AwardingFaction_Localised": {
      "title": "AwardingFaction_Localised",
      "type": "string",
      "examples": [
        "Pilots' Federation",
        "Frontline Solutions"
      ]
    },
    "VictimFaction": {
      "title": "VictimFaction",
      "type": "string",
      "examples": [
        "$faction_Thargoid;",
        "Azimuth Biotech",
        "HIP 44137 Partners"
      ]
    },
    "VictimFaction_Localised": {
      "title": "VictimFaction_Localised",
      "type": "string",
      "examples": [
        "Thargoids",
        "Frontline Solutions"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "AwardingFaction",
    "Reward",
    "VictimFaction",
    "event",
    "timestamp"
  ]
}
