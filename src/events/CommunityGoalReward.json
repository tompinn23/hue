{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when receiving a reward for a community goal",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "CGID": {
      "title": "CGID",
      "type": "integer",
      "examples": [
        754,
        758,
        690
      ]
    },
    "Name": {
      "title": "Name",
      "type": "string",
      "examples": [
        "Operation Tyndareus Reacts to Thargoid Fleet",
        "Disrupt Azimuth's Resource Campaign",
        "The Colonia Bridge Project 2nd Phase - Alcor"
      ]
    },
    "System": {
      "title": "System",
      "type": "string",
      "examples": [
        "Andecavi",
        "Wandrama",
        "Alcor"
      ]
    },
    "Reward": {
      "title": "Reward",
      "type": "integer",
      "examples": [
        8000000,
        2400000,
        10000000
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CGID",
    "Name",
    "Reward",
    "System",
    "event",
    "timestamp"
  ]
}
