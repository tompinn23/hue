{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when opting out of a community goal",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "CGID": {
      "title": "CGID",
      "type": "integer",
      "examples": [
        661,
        677,
        684
      ]
    },
    "Name": {
      "title": "Name",
      "type": "string",
      "examples": [
        "Engineered Detailed Surface Scanner Initiative",
        "Support Wreaken Construction Mining Campaign",
        "Support the Federation's Attempt to Capture Yuri Grom"
      ]
    },
    "System": {
      "title": "System",
      "type": "string",
      "examples": [
        "Luyten's Star",
        "EGM 559",
        "Delta Pavonis"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CGID",
    "Name",
    "System",
    "event",
    "timestamp"
  ]
}
