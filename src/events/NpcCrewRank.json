{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This is written when a crew member's combat rank increases",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "NpcCrewName": {
      "title": "NpcCrewName",
      "type": "string",
      "examples": [
        "Edmundo Frash"
      ]
    },
    "NpcCrewId": {
      "title": "NpcCrewId",
      "type": "integer",
      "examples": [
        218204548
      ]
    },
    "RankCombat": {
      "title": "RankCombat",
      "type": "integer",
      "examples": [
        5
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "NpcCrewId",
    "NpcCrewName",
    "RankCombat",
    "event",
    "timestamp"
  ]
}
