{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when hull health drops below a threshold (20% steps)",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Health": {
      "title": "Health",
      "type": "number",
      "examples": [
        0.761888,
        0.779891,
        0.578194
      ]
    },
    "PlayerPilot": {
      "title": "PlayerPilot",
      "description": "True if player is piloting the ship/fighter taking damage",
      "type": "boolean",
      "examples": [
        true,
        false
      ]
    },
    "Fighter": {
      "title": "Fighter",
      "description": "True for ship-launched fighter",
      "type": "boolean",
      "examples": [
        false,
        true
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Health",
    "PlayerPilot",
    "event",
    "timestamp"
  ]
}
