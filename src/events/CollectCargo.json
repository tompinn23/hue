{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when scooping cargo from space or planet surface",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "AncientRelic",
        "unknownresin",
        "unknownbiologicalmatter"
      ]
    },
    "Type_Localised": {
      "title": "Type_Localised",
      "description": "The localised value will be omitted if it is exactly the same as Type",
      "type": "string",
      "examples": [
        "Guardian Relic",
        "Thargoid Resin",
        "Thargoid Biological Matter"
      ]
    },
    "Stolen": {
      "title": "Stolen",
      "type": "boolean",
      "examples": [
        false,
        true
      ]
    },
    "MissionID": {
      "title": "MissionID",
      "type": "integer",
      "examples": [
        810908315,
        810908321,
        810908401
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Stolen",
    "Type",
    "event",
    "timestamp"
  ]
}
