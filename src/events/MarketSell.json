{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when selling goods in the market",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        128666762,
        128675207,
        128679815
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "water",
        "xihecompanions",
        "konggaale"
      ]
    },
    "Count": {
      "title": "Count",
      "type": "integer",
      "examples": [
        593,
        15,
        7
      ]
    },
    "SellPrice": {
      "title": "SellPrice",
      "description": "Price per unit",
      "type": "integer",
      "examples": [
        567,
        19180,
        16560
      ]
    },
    "TotalSale": {
      "title": "TotalSale",
      "description": "Total sale value",
      "type": "integer",
      "examples": [
        336231,
        287700,
        115920
      ]
    },
    "AvgPricePaid": {
      "title": "AvgPricePaid",
      "description": "Average price paid",
      "type": "integer",
      "examples": [
        42,
        4666,
        585
      ]
    },
    "Type_Localised": {
      "title": "Type_Localised",
      "description": "The localised value will be omitted if it is exactly the same as Type",
      "type": "string",
      "examples": [
        "Xihe Biomorphic Companions",
        "Kongga Ale",
        "Personal Weapons"
      ]
    },
    "StolenGoods": {
      "title": "StolenGoods",
      "description": "Whether goods were stolen",
      "type": "boolean",
      "examples": [
        true
      ]
    },
    "IllegalGoods": {
      "title": "IllegalGoods",
      "description": "Whether goods are illegal here",
      "type": "boolean",
      "examples": [
        true
      ]
    },
    "BlackMarket": {
      "title": "BlackMarket",
      "description": "Whether selling in a black market",
      "type": "boolean",
      "examples": [
        true
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "AvgPricePaid",
    "Count",
    "MarketID",
    "SellPrice",
    "TotalSale",
    "Type",
    "event",
    "timestamp"
  ]
}
