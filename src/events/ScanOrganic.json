{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This event is logged when the player uses the Organic Sampling Tool to scan, log or analyse organic discoveries. The first scan is Log, subsequent scans are Sample until fully scanned, final scan is Analyse",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "ScanType": {
      "title": "ScanType",
      "type": "string",
      "examples": [
        "Log",
        "Sample",
        "Analyse"
      ]
    },
    "Genus": {
      "title": "Genus",
      "type": "string",
      "examples": [
        "$Codex_Ent_Stratum_Genus_Name;",
        "$Codex_Ent_Bacterial_Genus_Name;",
        "$Codex_Ent_Fonticulus_Genus_Name;"
      ]
    },
    "Genus_Localised": {
      "title": "Genus_Localised",
      "type": "string",
      "examples": [
        "Stratum",
        "Bacterium",
        "Fonticulua"
      ]
    },
    "Species": {
      "title": "Species",
      "type": "string",
      "examples": [
        "$Codex_Ent_Stratum_07_Name;",
        "$Codex_Ent_Bacterial_12_Name;",
        "$Codex_Ent_Fonticulus_02_Name;"
      ]
    },
    "Species_Localised": {
      "title": "Species_Localised",
      "type": "string",
      "examples": [
        "Stratum Tectonicas",
        "Bacterium Cerbrus",
        "Fonticulua Campestris"
      ]
    },
    "Variant": {
      "title": "Variant",
      "type": "string",
      "examples": [
        "$Codex_Ent_Tubus_01_A_Name;"
      ]
    },
    "Variant_Localised": {
      "title": "Variant_Localised",
      "type": "string",
      "examples": [
        "Tubus Conifer - Indigo"
      ]
    },
    "WasLogged": {
      "title": "WasLogged",
      "type": "boolean",
      "examples": [
        false,
        true
      ]
    },
    "SystemAddress": {
      "title": "SystemAddress",
      "type": "integer",
      "examples": [
        647903226970,
        40406380861921,
        4226214177978
      ]
    },
    "Body": {
      "title": "Body",
      "type": "integer",
      "examples": [
        1,
        8,
        49
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Body",
    "Genus",
    "ScanType",
    "Species",
    "SystemAddress",
    "event",
    "timestamp"
  ]
}
