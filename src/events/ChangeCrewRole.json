{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when in a crew on someone else's ship, player switched crew role",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Role": {
      "title": "Role",
      "type": "string",
      "examples": [
        "OnFoot",
        "Helm",
        "Idle",
        "FireCon",
        "FighterCon"
      ]
    },
    "Telepresence": {
      "title": "Telepresence",
      "description": "Only from Odyssey build",
      "type": "boolean",
      "examples": [
        true
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Role",
    "event",
    "timestamp"
  ]
}
