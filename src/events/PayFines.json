{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when paying fines",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Amount": {
      "title": "Amount",
      "description": "Total amount paid, including any broker fee",
      "type": "integer",
      "examples": [
        550217,
        4875,
        23875
      ]
    },
    "AllFines": {
      "title": "AllFines",
      "type": "boolean",
      "examples": [
        true,
        false
      ]
    },
    "ShipID": {
      "title": "ShipID",
      "type": "integer",
      "examples": [
        5,
        12,
        34
      ]
    },
    "BrokerPercentage": {
      "title": "BrokerPercentage",
      "description": "Present if paid via a broker",
      "type": "number",
      "examples": [
        25.0
      ]
    },
    "Faction": {
      "title": "Faction",
      "description": "If paying off an individual faction's fines",
      "type": "string",
      "examples": [
        "Harow Commodities",
        "Cara Partnership",
        "HIP 44997 Legal Partners"
      ]
    },
    "Faction_Localised": {
      "title": "Faction_Localised",
      "description": "If paying off an individual faction's fines",
      "type": "string",
      "examples": [
        "Independent"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Amount",
    "ShipID",
    "event",
    "timestamp"
  ]
}
