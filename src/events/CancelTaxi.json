{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This event is logged if the player cancels a booked taxi trip",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Refund": {
      "title": "Refund",
      "type": "integer",
      "examples": [
        100,
        40172,
        21376
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Refund",
    "event",
    "timestamp"
  ]
}
