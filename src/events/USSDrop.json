{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when dropping from Supercruise at a Unidentified Signal Source",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "USSType": {
      "title": "USSType",
      "type": "string",
      "examples": [
        "$USS_Type_Salvage;",
        "$USS_Type_MissionTarget;",
        "$USS_Type_ValuableSalvage;"
      ]
    },
    "USSType_Localised": {
      "title": "USSType_Localised",
      "type": "string",
      "examples": [
        "Degraded emissions",
        "Target",
        "Encoded emissions"
      ]
    },
    "USSThreat": {
      "title": "USSThreat",
      "type": "integer",
      "examples": [
        0,
        6,
        2
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "USSThreat",
    "USSType",
    "event",
    "timestamp"
  ]
}
