{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when receiving salary payment from a power",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Power": {
      "title": "Power",
      "type": "string",
      "examples": [
        "Li Yong-Rui",
        "Aisling Duval"
      ]
    },
    "MeritsGained": {
      "title": "MeritsGained",
      "type": "integer",
      "examples": [
        100,
        50,
        200
      ]
    },
    "TotalMerits": {
      "title": "TotalMerits",
      "type": "integer",
      "examples": [
        15000,
        1000,
        26000
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "MeritsGained",
    "Power",
    "TotalMerits",
    "event",
    "timestamp"
  ]
}
