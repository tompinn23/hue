{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: at startup",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Combat": {
      "title": "Combat",
      "type": "integer",
      "examples": [
        6,
        7,
        5
      ]
    },
    "Trade": {
      "title": "Trade",
      "type": "integer",
      "examples": [
        9,
        8,
        13
      ]
    },
    "Explore": {
      "title": "Explore",
      "type": "integer",
      "examples": [
        8,
        9,
        10
      ]
    },
    "Soldier": {
      "title": "Soldier",
      "type": "integer",
      "examples": [
        5,
        6,
        1
      ]
    },
    "Exobiologist": {
      "title": "Exobiologist",
      "type": "integer",
      "examples": [
        0,
        8,
        2
      ]
    },
    "Empire": {
      "title": "Empire",
      "type": "integer",
      "examples": [
        12,
        0,
        14
      ]
    },
    "Federation": {
      "title": "Federation",
      "type": "integer",
      "examples": [
        12,
        0,
        14
      ]
    },
    "CQC": {
      "title": "CQC",
      "type": "integer",
      "examples": [
        0,
        3,
        6
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CQC",
    "Combat",
    "Empire",
    "Explore",
    "Federation",
    "Trade",
    "event",
    "timestamp"
  ]
}
