{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when selling unwanted drones back to the market",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "Drones"
      ]
    },
    "Count": {
      "title": "Count",
      "type": "integer",
      "examples": [
        16,
        20,
        56
      ]
    },
    "SellPrice": {
      "title": "SellPrice",
      "type": "integer",
      "examples": [
        101,
        100,
        90
      ]
    },
    "TotalSale": {
      "title": "TotalSale",
      "type": "integer",
      "examples": [
        1616,
        2020,
        5656
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Count",
    "SellPrice",
    "TotalSale",
    "Type",
    "event",
    "timestamp"
  ]
}
