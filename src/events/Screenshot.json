{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when a screen snapshot is saved. The latitude, longitude, altitude and heading will be included if on a planet or in low-altitude flight.",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Filename": {
      "title": "Filename",
      "description": "Filename of screenshot",
      "type": "string",
      "examples": [
        "Screenshot_0000.bmp",
        "Screenshot_0001.bmp",
        "Screenshot_0002.bmp"
      ]
    },
    "Width": {
      "title": "Width",
      "type": "integer",
      "examples": [
        2560,
        15360,
        3840
      ]
    },
    "Height": {
      "title": "Height",
      "type": "integer",
      "examples": [
        1440,
        6400,
        2160
      ]
    },
    "System": {
      "title": "System",
      "type": "string",
      "examples": [
        "Eocs Phyloea LD-K d8-0",
        "Dryao Ain QD-K c8-0",
        "Shrogaae KK-A d983"
      ]
    },
    "Body": {
      "title": "Body",
      "type": "string",
      "examples": [
        "Eocs Phyloea LD-K d8-0 ABC",
        "Dryao Ain QD-K c8-0",
        "Shrogaae KK-A d983 A 1 A Ring"
      ]
    },
    "Latitude": {
      "title": "Latitude",
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "examples": [
        -1.477483,
        -40.646881,
        22.613714
      ]
    },
    "Longitude": {
      "title": "Longitude",
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "examples": [
        -17.250286,
        -17.250288,
        -44.13446
      ]
    },
    "Altitude": {
      "title": "Altitude",
      "type": "number",
      "examples": [
        0.034059,
        1911.993042,
        68.702759
      ]
    },
    "Heading": {
      "title": "Heading",
      "type": "integer",
      "examples": [
        247,
        0,
        287
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Filename",
    "Height",
    "Width",
    "event",
    "timestamp"
  ]
}
