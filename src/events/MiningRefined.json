{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when mining fragments are converted unto a unit of cargo by refinery",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "$gallite_name;",
        "$bertrandite_name;",
        "$platinum_name;"
      ]
    },
    "Type_Localised": {
      "title": "Type_Localised",
      "type": "string",
      "examples": [
        "Gallite",
        "Bertrandite",
        "Platinum"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Type",
    "event",
    "timestamp"
  ]
}
