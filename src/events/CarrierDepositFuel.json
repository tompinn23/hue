{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "Any player giving fuel to the carrier",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "CarrierID": {
      "title": "CarrierID",
      "type": "integer",
      "examples": [
        3705689344,
        3707430144,
        3705124096
      ]
    },
    "Amount": {
      "title": "Amount",
      "type": "integer",
      "examples": [
        744,
        707,
        664
      ]
    },
    "Total": {
      "title": "Total",
      "description": "Total amount of fuel after donation",
      "type": "integer",
      "examples": [
        1000,
        510,
        818
      ]
    },
    "CarrierType": {
      "title": "CarrierType",
      "type": "string",
      "examples": [
        "FleetCarrier",
        "SquadronCarrier"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Amount",
    "CarrierID",
    "Total",
    "event",
    "timestamp"
  ]
}
