{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The carrier owner has changed the docking permission criteria",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "CarrierID": {
      "title": "CarrierID",
      "type": "integer",
      "examples": [
        3705689344,
        3705124096
      ]
    },
    "DockingAccess": {
      "title": "DockingAccess",
      "type": "string",
      "examples": [
        "all",
        "friends",
        "squadronfriends",
        "squadron",
        "none"
      ]
    },
    "AllowNotorious": {
      "title": "AllowNotorious",
      "type": "boolean",
      "examples": [
        true,
        false
      ]
    },
    "CarrierType": {
      "title": "CarrierType",
      "type": "string",
      "examples": [
        "FleetCarrier",
        "SquadronCarrier"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "AllowNotorious",
    "CarrierID",
    "DockingAccess",
    "event",
    "timestamp"
  ]
}
