{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: deploying the SRV from a ship onto planet surface",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "SRVType": {
      "title": "SRVType",
      "type": "string",
      "examples": [
        "combat_multicrew_srv_01",
        "testbuggy"
      ]
    },
    "SRVType_Localised": {
      "title": "SRVType_Localised",
      "type": "string",
      "examples": [
        "SRV Scorpion",
        "SRV Scarab"
      ]
    },
    "Loadout": {
      "title": "Loadout",
      "type": "string",
      "examples": [
        "default",
        "starter"
      ]
    },
    "ID": {
      "title": "ID",
      "type": "integer",
      "examples": [
        33,
        35,
        37
      ]
    },
    "PlayerControlled": {
      "title": "PlayerControlled",
      "type": "boolean",
      "examples": [
        true
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "ID",
    "Loadout",
    "PlayerControlled",
    "event",
    "timestamp"
  ]
}
