{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when scooping fuel from a star",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Scooped": {
      "title": "Scooped",
      "description": "Tons fuel scooped",
      "type": "number",
      "examples": [
        3.375821,
        0.382492,
        0.15318
      ]
    },
    "Total": {
      "title": "Total",
      "description": "Total fuel level after scooping",
      "type": "number",
      "examples": [
        25.817244,
        18.662706,
        15.467442
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Scooped",
    "Total",
    "event",
    "timestamp"
  ]
}
