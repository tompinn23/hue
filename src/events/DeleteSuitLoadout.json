{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This event is logged when the player deletes a suit loadout",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "SuitID": {
      "title": "SuitID",
      "type": "integer",
      "examples": [
        1722478814612428,
        1703397409838859,
        1700215335054978
      ]
    },
    "SuitName": {
      "title": "SuitName",
      "type": "string",
      "examples": [
        "utilitysuit_class2",
        "tacticalsuit_class3",
        "flightsuit"
      ]
    },
    "SuitName_Localised": {
      "title": "SuitName_Localised",
      "type": "string",
      "examples": [
        "$UtilitySuit_Class1_Name;",
        "$TacticalSuit_Class1_Name;",
        "Flight Suit"
      ]
    },
    "LoadoutID": {
      "title": "LoadoutID",
      "type": "integer",
      "examples": [
        4293000023,
        4293000000,
        4293000006
      ]
    },
    "LoadoutName": {
      "title": "LoadoutName",
      "type": "string",
      "examples": [
        "Scavenger",
        "Tanky",
        "Explorer"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "LoadoutID",
    "LoadoutName",
    "SuitID",
    "SuitName",
    "event",
    "timestamp"
  ]
}
