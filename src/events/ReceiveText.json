{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when a text message is received from another player or npc",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "From": {
      "title": "From",
      "type": "string",
      "examples": [
        "",
        "FleetCarrierName A1A-B2B",
        "$ShipName_Police_Independent;"
      ]
    },
    "Message": {
      "title": "Message",
      "type": "string",
      "examples": [
        "$COMMS_entered:#name=Asterope;",
        "$COMMS_entered:#name=Celaeno;",
        "$STATION_NoFireZone_entered;"
      ]
    },
    "Message_Localised": {
      "title": "Message_Localised",
      "type": "string",
      "examples": [
        "Entered Channel: Asterope",
        "Entered Channel: Celaeno",
        "No fire zone entered."
      ]
    },
    "Channel": {
      "title": "Channel",
      "type": "string",
      "examples": [
        "npc",
        "starsystem",
        "local"
      ]
    },
    "From_Localised": {
      "title": "From_Localised",
      "type": "string",
      "examples": [
        "System Authority Vessel",
        "System",
        "Cruise Ship"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Channel",
    "From",
    "Message",
    "event",
    "timestamp"
  ]
}
