{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when under fire (same time as the Under Attack voice message)",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Target": {
      "title": "Target",
      "type": "string",
      "examples": [
        "Fighter",
        "You",
        "Mothership"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "event",
    "timestamp"
  ]
}
