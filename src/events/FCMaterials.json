{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When trading with a Fleet Carrier Bartender for materials, a file is written with the pricelist to FCMaterials.json",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        3705124096,
        3707953408,
        3706338816
      ]
    },
    "CarrierName": {
      "title": "CarrierName",
      "type": "string",
      "examples": [
        "Carrier Name"
      ]
    },
    "CarrierID": {
      "title": "CarrierID",
      "type": "string",
      "examples": [
        "A1A-B2B"
      ]
    },
    "Items": {
      "title": "Items",
      "description": "Only included in FCMaterials.json",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "title": "id",
            "type": "integer",
            "examples": [
              128961556,
              128972334,
              128961527
            ]
          },
          "Name": {
            "title": "Name",
            "type": "string",
            "examples": [
              "$californium_name;",
              "$aerogel_name;",
              "$culinaryrecipes_name;"
            ]
          },
          "Name_Localised": {
            "title": "Name_Localised",
            "type": "string",
            "examples": [
              "Californium",
              "Aerogel",
              "Culinary Recipes"
            ]
          },
          "Price": {
            "title": "Price",
            "type": "integer",
            "examples": [
              74000,
              1000,
              400
            ]
          },
          "Stock": {
            "title": "Stock",
            "type": "integer",
            "examples": [
              0,
              20,
              18
            ]
          },
          "Demand": {
            "title": "Demand",
            "type": "integer",
            "examples": [
              0,
              1,
              98
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "Name",
          "Price",
          "Stock",
          "Demand"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "CarrierID",
    "CarrierName",
    "MarketID",
    "event",
    "timestamp"
  ]
}
