{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        0,
        3228917248,
        128858186
      ]
    },
    "ShipType": {
      "title": "ShipType",
      "type": "string",
      "examples": [
        "Mandalay",
        "corsair",
        "type9"
      ]
    },
    "ShipType_Localised": {
      "title": "ShipType_Localised",
      "type": "string",
      "examples": [
        "Beluga Liner",
        "Type-9 Heavy"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "MarketID",
    "ShipType",
    "event",
    "timestamp"
  ]
}
