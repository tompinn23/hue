{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This is written when crew receive wages",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "NpcCrewName": {
      "title": "NpcCrewName",
      "type": "string",
      "examples": [
        "Gavin Simmons",
        "Trinidad Prifti",
        "Edmundo Frash"
      ]
    },
    "NpcCrewId": {
      "title": "NpcCrewId",
      "type": "integer",
      "examples": [
        120523136,
        216828288,
        218204548
      ]
    },
    "Amount": {
      "title": "Amount",
      "type": "integer",
      "examples": [
        0,
        25480,
        61740
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Amount",
    "NpcCrewId",
    "NpcCrewName",
    "event",
    "timestamp"
  ]
}
