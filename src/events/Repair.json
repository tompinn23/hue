{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when repairing the ship. When repairing on a FleetCarrier, you can get a list of the modules repaired",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Cost": {
      "title": "Cost",
      "type": "integer",
      "examples": [
        8310,
        29660,
        8890
      ]
    },
    "Item": {
      "description": "all, wear, hull, paint, or name of module",
      "title": "Item",
      "type": "string",
      "examples": [
        "Wear",
        "Paint",
        "All"
      ]
    },
    "Items": {
      "title": "Items",
      "description": "when repairing on a FleetCarrier",
      "type": "array",
      "default": null,
      "items": {
        "type": "string",
        "examples": [
          "$asp_cockpit_name;",
          "Hull",
          "$modularcargobaydoor_name;"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "Cost",
    "event",
    "timestamp"
  ]
}
