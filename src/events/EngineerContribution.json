{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when offering items cash or bounties to an Engineer to gain access",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Engineer": {
      "title": "Engineer",
      "type": "string",
      "examples": [
        "Zacariah Nemo",
        "Lori Jameson",
        "The Sarge"
      ]
    },
    "EngineerID": {
      "title": "EngineerID",
      "type": "integer",
      "examples": [
        300050,
        300230,
        300040
      ]
    },
    "Type": {
      "title": "Type",
      "type": "string",
      "examples": [
        "Commodity",
        "Materials",
        "Bounty"
      ]
    },
    "Commodity": {
      "title": "Commodity",
      "type": "string",
      "examples": [
        "xihecompanions",
        "konggaale",
        "bromellite"
      ]
    },
    "Commodity_Localised": {
      "title": "Commodity_Localised",
      "type": "string",
      "examples": [
        "Xihe Biomorphic Companions",
        "Kongga Ale",
        "Occupied Escape Pod"
      ]
    },
    "Quantity": {
      "title": "Quantity",
      "description": "Quantity offered this time",
      "type": "integer",
      "examples": [
        25,
        16,
        9
      ]
    },
    "TotalQuantity": {
      "title": "TotalQuantity",
      "description": "Total amount donated",
      "type": "integer",
      "examples": [
        25,
        16,
        50
      ]
    },
    "Material": {
      "title": "Material",
      "type": "string",
      "examples": [
        "shieldpatternanalysis"
      ]
    },
    "Material_Localised": {
      "title": "Material_Localised",
      "type": "string",
      "examples": [
        "Aberrant Shield Pattern Analysis"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Engineer",
    "EngineerID",
    "Quantity",
    "TotalQuantity",
    "Type",
    "event",
    "timestamp"
  ]
}
