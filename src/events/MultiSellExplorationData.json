{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when selling exploration data in Cartographics, a page at a time",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Discovered": {
      "title": "Discovered",
      "type": "array",
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "SystemName": {
            "title": "SystemName",
            "type": "string",
            "examples": [
              "HD 111990",
              "NGC 4755 BK 125",
              "HR 4876"
            ]
          },
          "SystemName_Localised": {
            "title": "SystemName_Localised",
            "description": "This field sometime appears in this event containing random data (bug)",
            "type": "string",
            "examples": [
              "Random stuff"
            ]
          },
          "NumBodies": {
            "title": "NumBodies",
            "type": "integer",
            "examples": [
              9,
              7,
              4
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "SystemName",
          "NumBodies"
        ]
      }
    },
    "BaseValue": {
      "title": "BaseValue",
      "type": "integer",
      "examples": [
        2842803,
        2415839,
        3663580
      ]
    },
    "Bonus": {
      "title": "Bonus",
      "type": "integer",
      "examples": [
        0,
        72000,
        66804
      ]
    },
    "TotalEarnings": {
      "title": "TotalEarnings",
      "type": "integer",
      "examples": [
        2842803,
        2487839,
        3663580
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "BaseValue",
    "Bonus",
    "Discovered",
    "TotalEarnings",
    "event",
    "timestamp"
  ]
}
