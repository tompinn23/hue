{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: after using the Surface Area Analysis Scanner",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "BodyName": {
      "title": "BodyName",
      "type": "string",
      "examples": [
        "Swoiwns ZD-B d1 1 B Ring",
        "Swoiwns ZD-B d1 1 A Ring",
        "HIP 62918 1"
      ]
    },
    "SystemAddress": {
      "title": "SystemAddress",
      "type": "integer",
      "examples": [
        44753062275,
        743701424945,
        2831053823913
      ]
    },
    "BodyID": {
      "title": "BodyID",
      "type": "integer",
      "examples": [
        23,
        22,
        1
      ]
    },
    "ProbesUsed": {
      "title": "ProbesUsed",
      "type": "integer",
      "examples": [
        1,
        5,
        4
      ]
    },
    "EfficiencyTarget": {
      "title": "EfficiencyTarget",
      "type": "integer",
      "examples": [
        0,
        8,
        6
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "BodyID",
    "BodyName",
    "EfficiencyTarget",
    "ProbesUsed",
    "SystemAddress",
    "event",
    "timestamp"
  ]
}
