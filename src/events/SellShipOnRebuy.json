{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: When selling a stored ship to raise funds when on insurance/rebuy screen",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "ShipType": {
      "title": "ShipType",
      "type": "string",
      "examples": [
        "Dolphin"
      ]
    },
    "System": {
      "title": "System",
      "type": "string",
      "examples": [
        "Shinrarta Dezhra"
      ]
    },
    "SellShipId": {
      "title": "SellShipId",
      "type": "integer",
      "examples": [
        4
      ]
    },
    "ShipPrice": {
      "title": "ShipPrice",
      "type": "integer",
      "examples": [
        4110183
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "SellShipId",
    "ShipPrice",
    "ShipType",
    "System",
    "event",
    "timestamp"
  ]
}
