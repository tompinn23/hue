{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Success": {
      "title": "Success",
      "type": "boolean",
      "examples": [
        true
      ]
    },
    "Submitted": {
      "title": "Submitted",
      "type": "boolean",
      "examples": [
        true
      ]
    },
    "Interdicted": {
      "title": "Interdicted",
      "description": "Victim pilot name",
      "type": "string",
      "examples": [
        "Fred Flintstone",
        "$ShipName_PassengerLiner_Cruise;"
      ]
    },
    "Interdicted_Localised": {
      "title": "Interdicted_Localised",
      "description": "Victim pilot name",
      "type": "string",
      "examples": [
        "Kreuzfahrtschiff"
      ]
    },
    "IsPlayer": {
      "title": "IsPlayer",
      "description": "Whether player or npc",
      "type": "boolean",
      "examples": [
        true
      ]
    },
    "CombatRank": {
      "title": "CombatRank",
      "description": "If a player",
      "type": "integer",
      "examples": [
        5
      ]
    },
    "Faction": {
      "title": "Faction",
      "description": "If npc",
      "type": "string",
      "examples": [
        "Royal Phoenix Corporation",
        "The Ant Hill Mob",
        "LFT 926 Blue Hand Gang"
      ]
    },
    "Power": {
      "title": "Power",
      "description": "If npc is working for a power",
      "type": "string",
      "examples": [
        "Independent"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Interdicted",
    "IsPlayer",
    "Success",
    "event",
    "timestamp"
  ]
}
