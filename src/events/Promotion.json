{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when the player’s rank increases. Only the relevant ranks are included.",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Explore": {
      "title": "Explore",
      "type": "integer",
      "examples": [
        9,
        10,
        4
      ]
    },
    "Combat": {
      "title": "Combat",
      "type": "integer",
      "examples": [
        7,
        6,
        9
      ]
    },
    "Soldier": {
      "title": "Soldier",
      "type": "integer",
      "examples": [
        6,
        2,
        3
      ]
    },
    "Federation": {
      "title": "Federation",
      "type": "integer",
      "examples": [
        24,
        12,
        1
      ]
    },
    "Exobiologist": {
      "title": "Exobiologist",
      "type": "integer",
      "examples": [
        2,
        9,
        11
      ]
    },
    "Empire": {
      "title": "Empire",
      "type": "integer",
      "examples": [
        14
      ]
    },
    "Trade": {
      "title": "Trade",
      "type": "integer",
      "examples": [
        9,
        10,
        11
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "event",
    "timestamp"
  ]
}
