{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when engaging a new member of crew",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Name": {
      "title": "Name",
      "type": "string",
      "examples": [
        "Alice",
        "Bob",
        "Mallory"
      ]
    },
    "CrewID": {
      "title": "CrewID",
      "type": "integer",
      "examples": [
        216828288,
        218204548,
        230047520
      ]
    },
    "Faction": {
      "title": "Faction",
      "type": "string",
      "examples": [
        "LTT 4487 Industry",
        "League of Azaladshu Defence Party",
        "Neche Inc"
      ]
    },
    "Cost": {
      "title": "Cost",
      "type": "integer",
      "examples": [
        15000,
        150000,
        55000
      ]
    },
    "CombatRank": {
      "title": "CombatRank",
      "type": "integer",
      "examples": [
        0,
        4,
        2
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CombatRank",
    "Cost",
    "CrewID",
    "Faction",
    "Name",
    "event",
    "timestamp"
  ]
}
