{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This event is logged when buying a new suit",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Name": {
      "title": "Name",
      "type": "string",
      "examples": [
        "ExplorationSuit_Class2",
        "UtilitySuit_Class3",
        "UtilitySuit_Class2"
      ]
    },
    "Name_Localised": {
      "title": "Name_Localised",
      "type": "string",
      "examples": [
        "$ExplorationSuit_Class1_Name;",
        "$UtilitySuit_Class1_Name;",
        "$TacticalSuit_Class1_Name;"
      ]
    },
    "Price": {
      "title": "Price",
      "type": "integer",
      "examples": [
        2250000,
        750000,
        3750000
      ]
    },
    "SuitID": {
      "title": "SuitID",
      "type": "integer",
      "examples": [
        1734434022684162,
        1734434028284341,
        1701563085654285
      ]
    },
    "SuitMods": {
      "title": "SuitMods",
      "type": "array",
      "default": null,
      "items": {
        "type": "string",
        "examples": [
          "suit_backpackcapacity",
          "suit_increasedammoreserves",
          "suit_adsmovementspeed"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "Name",
    "Price",
    "SuitID",
    "SuitMods",
    "event",
    "timestamp"
  ]
}
