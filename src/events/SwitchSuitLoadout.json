{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This event is logged when a player selects a different flight suit from the ship’s locker",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "SuitID": {
      "title": "SuitID",
      "type": "integer",
      "examples": [
        1700584662244668,
        1722394975087596,
        1722459290508954
      ]
    },
    "SuitName": {
      "title": "SuitName",
      "type": "string",
      "examples": [
        "tacticalsuit_class3",
        "utilitysuit_class3",
        "utilitysuit_class5"
      ]
    },
    "SuitName_Localised": {
      "title": "SuitName_Localised",
      "type": "string",
      "examples": [
        "$TacticalSuit_Class1_Name;",
        "$UtilitySuit_Class1_Name;",
        "$ExplorationSuit_Class1_Name;"
      ]
    },
    "SuitMods": {
      "title": "SuitMods",
      "type": "array",
      "default": null,
      "items": {
        "type": "string",
        "examples": [
          "suit_increasedo2capacity",
          "suit_reducedtoolbatteryconsumption",
          "suit_backpackcapacity"
        ]
      }
    },
    "LoadoutID": {
      "title": "LoadoutID",
      "type": "integer",
      "examples": [
        4293000000,
        4293000002,
        4293000006
      ]
    },
    "LoadoutName": {
      "title": "LoadoutName",
      "type": "string",
      "examples": [
        "no reload test",
        "tooltest",
        "MAv red tool"
      ]
    },
    "Modules": {
      "title": "Modules",
      "type": "array",
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "SlotName": {
            "title": "SlotName",
            "type": "string",
            "examples": [
              "PrimaryWeapon1",
              "PrimaryWeapon2",
              "SecondaryWeapon"
            ]
          },
          "SuitModuleID": {
            "title": "SuitModuleID",
            "type": "integer",
            "examples": [
              1700362936206349,
              1700314434564508,
              1700314469329676
            ]
          },
          "ModuleName": {
            "title": "ModuleName",
            "type": "string",
            "examples": [
              "wpn_m_assaultrifle_laser_fauto",
              "wpn_m_submachinegun_kinetic_fauto",
              "wpn_m_sniper_plasma_charged"
            ]
          },
          "ModuleName_Localised": {
            "title": "ModuleName_Localised",
            "type": "string",
            "examples": [
              "TK Aphelion",
              "Karma C-44",
              "Manticore Executioner"
            ]
          },
          "Class": {
            "title": "Class",
            "type": "integer",
            "examples": [
              1,
              5,
              3
            ]
          },
          "WeaponMods": {
            "title": "WeaponMods",
            "type": "array",
            "default": null,
            "items": {
              "type": "string",
              "examples": [
                "weapon_suppression_unpressurised",
                "weapon_handling",
                "weapon_reloadspeed"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "SlotName",
          "SuitModuleID",
          "ModuleName",
          "Class",
          "WeaponMods"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "LoadoutID",
    "LoadoutName",
    "Modules",
    "SuitID",
    "SuitMods",
    "SuitName",
    "event",
    "timestamp"
  ]
}
