{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "ShipType": {
      "title": "ShipType",
      "type": "string",
      "examples": [
        "asp",
        "anaconda",
        "empire_courier"
      ]
    },
    "ShipType_Localised": {
      "title": "ShipType_Localised",
      "type": "string",
      "examples": [
        "Asp Explorer",
        "Imperial Courier"
      ]
    },
    "ShipID": {
      "title": "ShipID",
      "type": "integer",
      "examples": [
        34,
        7,
        44
      ]
    },
    "ShipMarketID": {
      "title": "ShipMarketID",
      "type": "integer",
      "examples": [
        3705689344,
        3706338816
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        3705689344,
        3706338816
      ]
    },
    "System": {
      "title": "System",
      "type": "string",
      "examples": [
        "Tascheter Sector AV-Y b5"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "MarketID",
    "ShipID",
    "ShipMarketID",
    "ShipType",
    "event",
    "timestamp"
  ]
}
