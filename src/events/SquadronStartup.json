{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "SquadronName": {
      "title": "SquadronName",
      "type": "string",
      "examples": [
        "TestSquadron"
      ]
    },
    "CurrentRank": {
      "title": "CurrentRank",
      "type": "integer",
      "examples": [
        3,
        0,
        4
      ]
    },
    "CurrentRankName": {
      "title": "CurrentRankName",
      "type": "string",
      "examples": [
        "Pilot",
        "$Squadron_DefaultRankName_Rank0;"
      ]
    },
    "CurrentRankName_Localised": {
      "title": "CurrentRankName_Localised",
      "type": "string",
      "examples": [
        "Pilot"
      ]
    },
    "SquadronID": {
      "title": "SquadronID",
      "type": "integer",
      "examples": [
        3,
        0,
        4
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CurrentRank",
    "SquadronName",
    "event",
    "timestamp"
  ]
}
