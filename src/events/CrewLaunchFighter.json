{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when in multicrew, in Helm player's log, when a crew member launches a fighter",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Telepresence": {
      "title": "Telepresence",
      "description": "only from Odyssey build",
      "type": "boolean",
      "examples": [
        false
      ]
    },
    "Crew": {
      "title": "Crew",
      "description": "Name of crew member launching in fighter",
      "type": "string",
      "examples": [
        "Alice",
        "Bob"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Crew",
    "Telepresence",
    "event",
    "timestamp"
  ]
}
