{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "This event is written when completing a Full Spectrum Scan of a starsystem, to list the number of SAA signals found in the system (as shown in-game in the top-right panel)",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "BodyName": {
      "title": "BodyName",
      "type": "string",
      "examples": [
        "BS Crucis 5 a",
        "BS Crucis 1",
        "BS Crucis 7 c a"
      ]
    },
    "BodyID": {
      "title": "BodyID",
      "type": "integer",
      "examples": [
        33,
        2,
        47
      ]
    },
    "SystemAddress": {
      "title": "SystemAddress",
      "type": "integer",
      "examples": [
        10043270500,
        2943530117929,
        2944872557345
      ]
    },
    "Signals": {
      "title": "Signals",
      "type": "array",
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "Type": {
            "title": "Type",
            "type": "string",
            "examples": [
              "$SAA_SignalType_Geological;",
              "$SAA_SignalType_Biological;"
            ]
          },
          "Type_Localised": {
            "title": "Type_Localised",
            "type": "string",
            "examples": [
              "Geological",
              "Biological"
            ]
          },
          "Count": {
            "title": "Count",
            "type": "integer",
            "examples": [
              3,
              2,
              1
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "Type",
          "Count"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "BodyID",
    "BodyName",
    "Signals",
    "SystemAddress",
    "event",
    "timestamp"
  ]
}
