{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when selling a ship stored in the shipyard",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "ShipType": {
      "title": "ShipType",
      "type": "string",
      "examples": [
        "sidewinder",
        "type7",
        "anaconda"
      ]
    },
    "SellShipID": {
      "title": "SellShipID",
      "type": "integer",
      "examples": [
        36,
        68,
        6
      ]
    },
    "ShipPrice": {
      "title": "ShipPrice",
      "type": "integer",
      "examples": [
        28080,
        12730985,
        104262846
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        3226858240,
        128666762
      ]
    },
    "ShipType_Localised": {
      "title": "ShipType_Localised",
      "type": "string",
      "examples": [
        "Type-7 Transporter",
        "Asp Explorer",
        "Fer-de-Lance"
      ]
    },
    "System": {
      "title": "System",
      "description": "If ship is in another system",
      "type": "string",
      "examples": [
        "Zeaex",
        "Wiliajuk",
        "Harow"
      ]
    },
    "ShipMarketID": {
      "title": "ShipMarketID",
      "type": "integer",
      "examples": [
        128110840,
        3227808512,
        3706338816
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "MarketID",
    "SellShipID",
    "ShipPrice",
    "ShipType",
    "event",
    "timestamp"
  ]
}
