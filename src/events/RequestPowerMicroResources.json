{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when requesting power micro-resources.",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "TotalCount": {
      "title": "TotalCount",
      "description": "The total number of micro-resources requested.",
      "type": "integer",
      "examples": [
        1,
        2,
        3
      ]
    },
    "MicroResources": {
      "title": "MicroResources",
      "description": "Details of the micro-resources requested.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "title": "Name",
            "description": "The internal name of the micro-resource.",
            "type": "string",
            "examples": [
              "powerfinancialrecords"
            ]
          },
          "Name_Localised": {
            "title": "Name_Localised",
            "description": "The localized name of the micro-resource.",
            "type": "string",
            "examples": [
              "Power Industrial Data"
            ]
          },
          "Category": {
            "title": "Category",
            "description": "The category of the micro-resource.",
            "type": "string",
            "examples": [
              "Data"
            ]
          },
          "Count": {
            "title": "Count",
            "description": "The count of this type of micro-resource.",
            "type": "integer",
            "examples": [
              1
            ]
          }
        },
        "required": [
          "Name",
          "Category",
          "Count"
        ],
        "additionalProperties": false
      }
    },
    "MarketID": {
      "title": "MarketID",
      "description": "The ID of the market where the request took place.",
      "type": "integer",
      "examples": [
        3223182848
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "MarketID",
    "MicroResources",
    "TotalCount",
    "event",
    "timestamp"
  ]
}
