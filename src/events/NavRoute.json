{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When plotting a multi-star route, the file NavRoute.json is written in the same directory as the journal, with a list of stars along that route",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Route": {
      "title": "Route",
      "type": "array",
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "StarSystem": {
            "title": "StarSystem",
            "type": "string",
            "examples": [
              "i Bootis",
              "Acihaut",
              "LHS 455"
            ]
          },
          "SystemAddress": {
            "title": "SystemAddress",
            "type": "integer",
            "examples": [
              1281787693419,
              11665802405289,
              3686969379179
            ]
          },
          "StarPos": {
            "title": "StarPos",
            "description": "star position, as a Json array [x, y, z], relative to Sol in Ly",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "examples": [
                -81.09375,
                -148.3125,
                -337.09375
              ]
            }
          },
          "StarClass": {
            "title": "StarClass",
            "type": "string",
            "examples": [
              "G",
              "M",
              "DQ"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "StarSystem",
          "SystemAddress",
          "StarPos",
          "StarClass"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "event",
    "timestamp"
  ]
}
