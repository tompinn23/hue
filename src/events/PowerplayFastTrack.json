{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when paying to fast-track allocation of commodities",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Power": {
      "title": "Power",
      "type": "string",
      "examples": [
        "Li Yong-Rui",
        "Aisling Duval",
        "Edmund Mahon"
      ]
    },
    "Cost": {
      "title": "Cost",
      "type": "integer",
      "examples": [
        100000,
        500000
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Cost",
    "Power",
    "event",
    "timestamp"
  ]
}
