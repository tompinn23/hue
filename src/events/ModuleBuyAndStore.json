{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When Written: when buying a module and directly storing it in outfitting",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "BuyItem": {
      "title": "BuyItem",
      "description": "The module being purchased and stored",
      "type": "string",
      "examples": [
        "$int_dronecontrol_unkvesselresearch_name;",
        "$int_multidronecontrol_xeno_size3_class3_name;",
        "$int_multidronecontrol_mining_size3_class3_name;"
      ]
    },
    "BuyItem_Localised": {
      "title": "BuyItem_Localised",
      "type": "string",
      "examples": [
        "Research",
        "Xeno Multi-Limpet Controller",
        "Mining Multi-Limpet Controller"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        128666762,
        128679559,
        128927917
      ]
    },
    "BuyPrice": {
      "title": "BuyPrice",
      "description": "Price paid",
      "type": "integer",
      "examples": [
        1535274,
        43875,
        70200
      ]
    },
    "Ship": {
      "title": "Ship",
      "description": "The player's ship",
      "type": "string",
      "examples": [
        "asp",
        "cutter",
        "krait_mkii"
      ]
    },
    "ShipID": {
      "title": "ShipID",
      "description": "The player's ship ID",
      "type": "integer",
      "examples": [
        5,
        25,
        34
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "BuyItem",
    "BuyPrice",
    "MarketID",
    "Ship",
    "ShipID",
    "event",
    "timestamp"
  ]
}
