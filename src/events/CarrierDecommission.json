{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "At the time the player requests decommission",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "CarrierID": {
      "title": "CarrierID",
      "type": "integer",
      "examples": [
        3700005632
      ]
    },
    "ScrapRefund": {
      "title": "ScrapRefund",
      "type": "integer",
      "examples": [
        1746872629
      ]
    },
    "ScrapTime": {
      "title": "ScrapTime",
      "type": "integer",
      "examples": [
        1584601200
      ]
    },
    "CarrierType": {
      "title": "CarrierType",
      "type": "string",
      "examples": [
        "FleetCarrier",
        "SquadronCarrier"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CarrierID",
    "ScrapRefund",
    "ScrapTime",
    "event",
    "timestamp"
  ]
}
