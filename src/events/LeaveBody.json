{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when flying away from a planet, and distance increases above the 'Orbital Cruise' altitude",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "StarSystem": {
      "title": "StarSystem",
      "type": "string",
      "examples": [
        "HIP 20485",
        "Sol",
        "Latorioson"
      ]
    },
    "SystemAddress": {
      "title": "SystemAddress",
      "type": "integer",
      "examples": [
        3657265287866,
        10477373803,
        671222670713
      ]
    },
    "Body": {
      "title": "Body",
      "type": "string",
      "examples": [
        "HIP 20485 C 5",
        "Vanth",
        "Actaea"
      ]
    },
    "BodyID": {
      "title": "BodyID",
      "type": "integer",
      "examples": [
        35,
        38,
        15
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Body",
    "BodyID",
    "StarSystem",
    "SystemAddress",
    "event",
    "timestamp"
  ]
}
