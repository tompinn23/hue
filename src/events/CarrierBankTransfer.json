{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "Player transfers credits to/from carrier",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "CarrierID": {
      "title": "CarrierID",
      "type": "integer",
      "examples": [
        3707430144,
        3705689344,
        3705124096
      ]
    },
    "CarrierType": {
      "title": "CarrierType",
      "type": "string",
      "examples": [
        "FleetCarrier",
        "SquadronCarrier"
      ]
    },
    "Deposit": {
      "title": "Deposit",
      "type": "integer",
      "examples": [
        1568400000,
        2122500000,
        872810000
      ]
    },
    "Withdraw": {
      "title": "Withdraw",
      "type": "integer",
      "examples": [
        4060,
        869994,
        2370000
      ]
    },
    "PlayerBalance": {
      "title": "PlayerBalance",
      "description": "Player balance after transfer",
      "type": "integer",
      "examples": [
        500008232,
        2435383946,
        173416954
      ]
    },
    "CarrierBalance": {
      "title": "CarrierBalance",
      "description": "Carrier balance after transfer",
      "type": "integer",
      "examples": [
        1568400000,
        3058818193,
        1490320265
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "CarrierBalance",
    "CarrierID",
    "PlayerBalance",
    "event",
    "timestamp"
  ]
}
