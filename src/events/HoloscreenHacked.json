{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When a holoscreen is hacked",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "PowerBefore": {
      "title": "PowerBefore",
      "description": "The power that owned the holo screen",
      "type": "string",
      "examples": [
        "Archon Delaine",
        "Yuri Grom",
        "Aisling Duval"
      ]
    },
    "PowerAfter": {
      "title": "PowerAfter",
      "description": "The power that now owns the holo screen",
      "type": "string",
      "examples": [
        "Archon Delaine",
        "Yuri Grom",
        "Aisling Duval"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "PowerAfter",
    "PowerBefore",
    "event",
    "timestamp"
  ]
}
