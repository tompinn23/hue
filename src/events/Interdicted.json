{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: player was interdicted by player or npc",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Submitted": {
      "title": "Submitted",
      "type": "boolean",
      "examples": [
        false,
        true
      ]
    },
    "Interdictor": {
      "title": "Interdictor",
      "type": "string",
      "examples": [
        "Bob Royall",
        "Markus Klaus",
        "Dirk Gently"
      ]
    },
    "IsPlayer": {
      "title": "IsPlayer",
      "description": "Whether player or npc",
      "type": "boolean",
      "examples": [
        false
      ]
    },
    "IsThargoid": {
      "title": "IsThargoid",
      "description": "Whether thargoid",
      "type": "boolean",
      "examples": [
        true,
        false
      ]
    },
    "CombatRank": {
      "title": "CombatRank",
      "description": "If player",
      "type": "integer",
      "examples": [
        8
      ]
    },
    "Faction": {
      "title": "Faction",
      "description": "If npc",
      "type": "string",
      "examples": [
        "Royal Phoenix Corporation",
        "The Ant Hill Mob",
        "LFT 926 Blue Hand Gang"
      ]
    },
    "Power": {
      "title": "Power",
      "description": "If npc is working for a power",
      "type": "string",
      "examples": [
        "Independent"
      ]
    },
    "Interdictor_Localised": {
      "title": "Interdictor_Localised",
      "type": "string",
      "examples": [
        "System Authority Vessel",
        "Allied Police Forces",
        "Federal Security Service"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "IsPlayer",
    "Submitted",
    "event",
    "timestamp"
  ]
}
