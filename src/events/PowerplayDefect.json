{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when a player defects from one power to another",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "FromPower": {
      "title": "FromPower",
      "type": "string",
      "examples": [
        "Aisling Duval"
      ]
    },
    "ToPower": {
      "title": "ToPower",
      "type": "string",
      "examples": [
        "Li Yong-Rui"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "FromPower",
    "ToPower",
    "event",
    "timestamp"
  ]
}
