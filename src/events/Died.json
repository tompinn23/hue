{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: player was killed",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "KillerName": {
      "title": "KillerName",
      "description": "When killed by a single entity",
      "type": "string",
      "examples": [
        "Cmdr banana",
        "$UNKNOWN;",
        "Cmdr apple"
      ]
    },
    "KillerShip": {
      "title": "KillerShip",
      "description": "When killed by a single entity",
      "type": "string",
      "examples": [
        "utilitysuit_class5",
        "ps_turretbasemedium02_6m",
        "scout_q"
      ]
    },
    "KillerRank": {
      "title": "KillerRank",
      "description": "When killed by a single entity",
      "type": "string",
      "examples": [
        "Master",
        "Elite",
        "Deadly"
      ]
    },
    "KillerName_Localised": {
      "title": "KillerName_Localised",
      "description": "When killed by a single entity",
      "type": "string",
      "examples": [
        "Unknown",
        "Internal Security Service",
        "System Authority Vessel"
      ]
    },
    "Killers": {
  "title": "Killers",
  "description": "When killed by a wing",
  "type": "array",
  "default": null,
  "items": {
    "type": "object",
    "properties": {
      "KillerName": {
        "title": "KillerName",
        "type": "string",
        "examples": ["Cmdr Alice", "$UNKNOWN;", "Cmdr Bob"]
      },
      "KillerShip": {
        "title": "KillerShip",
        "type": "string",
        "examples": ["utilitysuit_class5", "ps_turretbasemedium02_6m", "scout_q"]
      },
      "KillerRank": {
        "title": "KillerRank",
        "type": "string",
        "examples": ["Master", "Elite", "Deadly"]
      },
      "KillerName_Localised": {
        "title": "KillerName_Localised",
        "type": "string",
        "examples": ["Unknown", "Internal Security Service", "System Authority Vessel"]
      }
    },
    "required": ["KillerName", "KillerShip", "KillerRank"]
  }
}
  },
  "additionalProperties": false,
  "required": [
    "event",
    "timestamp"
  ]
}
