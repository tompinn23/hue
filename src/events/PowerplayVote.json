{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when voting for a system expansion",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Power": {
      "title": "Power",
      "type": "string",
      "examples": [
        "Aisling Duval"
      ]
    },
    "Votes": {
      "title": "Votes",
      "type": "integer",
      "examples": [
        1
      ]
    },
    "VoteToConsolidate": {
      "title": "VoteToConsolidate",
      "type": "integer",
      "examples": [
        1
      ]
    },
    "System": {
      "title": "System",
      "description": "Documented, but appears to be unused.",
      "type": "string",
      "examples": [
        "LFT 926",
        "Shinrarta Dezhra",
        "Cloomeia FG-Y e95"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Power",
    "VoteToConsolidate",
    "Votes",
    "event",
    "timestamp"
  ]
}
