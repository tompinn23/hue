{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when delivering items to a Search and Rescue contact",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "MarketID": {
      "title": "MarketID",
      "type": "integer",
      "examples": [
        128666762
      ]
    },
    "Name": {
      "title": "Name",
      "type": "string",
      "examples": [
        "occupiedcryopod",
        "damagedescapepod"
      ]
    },
    "Name_Localised": {
      "title": "Name_Localised",
      "type": "string",
      "examples": [
        "Occupied Escape Pod",
        "Damaged Escape Pod"
      ]
    },
    "Count": {
      "title": "Count",
      "type": "integer",
      "examples": [
        6,
        3
      ]
    },
    "Reward": {
      "title": "Reward",
      "type": "integer",
      "examples": [
        164376,
        45855
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Count",
    "MarketID",
    "Name",
    "Reward",
    "event",
    "timestamp"
  ]
}
