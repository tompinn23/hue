{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "When written: when assigning a name to the ship in Starport Services",
  "properties": {
    "timestamp": {
      "title": "timestamp",
      "description": "Timestamp in UTC, ISO 8601",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2022-09-11T22:00:45Z",
        "2022-09-12T08:54:21Z",
        "2022-09-12T08:54:24Z"
      ]
    },
    "event": {
      "title": "event",
      "type": "string",
      "examples": [
        "AfmuRepairs",
        "FSDJump",
        "Location"
      ]
    },
    "Ship": {
      "title": "Ship",
      "type": "string",
      "examples": [
        "asp",
        "python",
        "empire_courier"
      ]
    },
    "ShipID": {
      "title": "ShipID",
      "type": "integer",
      "examples": [
        34,
        27,
        12
      ]
    },
    "UserShipName": {
      "title": "UserShipName",
      "type": "string",
      "examples": [
        "Goidgobbler",
        "",
        "Starhopper"
      ]
    },
    "UserShipId": {
      "title": "UserShipId",
      "type": "string",
      "examples": [
        "ASP-01",
        "",
        "KM2-02"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "Ship",
    "ShipID",
    "UserShipId",
    "UserShipName",
    "event",
    "timestamp"
  ]
}
